{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push origin master)",
      "Bash(git push * master)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(* .env.local*)",
      "Bash(* .env.production*)",
      "Bash(* .env.development*)",
      "Bash(* .env.staging*)",
      "Bash(* .env.test*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(docker *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh repo view*)",
      "Read(**/.env.example)"
    ]
  }
}
