# Copy to .env and fill in. Bun loads .env by itself. See docs/configuration.md.

# Postgres connection string (required by serve and db:migrate).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{db}}
# Public URL; POSTs from any other Origin are refused.
APP_URL=http://localhost:3000
# Port the server listens on.
PORT=3000
# Version shown by /healthz.
APP_VERSION=dev
# Tests only: base URL of the test database (each worktree gets its own copy).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{db}}_test
